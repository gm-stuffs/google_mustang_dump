#
# Mustang sensor device configuration registry script for the DVT stage and after.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x50000:0xFFFF0000
# Exclude
?-0x52000:0xFFFFF000  # Proto
?-0x53000:0xFFFFF000  # EVT

#
# Record reg_script.
#

+/
reg_script=mustang_dvt.reg

#
# Sensors
#

# MAG (MC5616WA)
+/dev/mmc5616/0/mag
  fac_cal_transform=0.9510 -0.0607 -0.0273 -0.0094 1.0176 0.0073 -0.0830 0.0090 1.1853 0 0 0
  curr_comp_factors=11.40 -6.53 6.66
  curr_comp_factors_fast=2.77 -2.34 1.85

# ALSP (TMD3743)
+/dev/tmd3743/0/als
  x_scale=1.02494
  lux_scale=1.02069
  z_scale=1.00897
  x_crgbw_coefs=-37.408235 43.854591 129.513772 -9.300066 -2.601188
  lux_crgbw_coefs=-27.257599 26.672212 124.899590 0.132850 -1.952329
  z_crgbw_coefs=30.456540 -57.486146 -0.813766 132.762996 1.365894

+/dev/tmd3743/0/prox
  pulse_count=2
  pulse_len_us=63

# RAINBOW (VD6282)
+/dev/vd6282/0/spectral
  # Golden values for calibration.
  golden_rals_r=1016.04023437
  golden_rals_g=1130.3703125
  golden_rals_b=296.423828125
  golden_rals_clr1=4998.76679688
  golden_rals_ir=3118.38085938
  golden_rals_clr2=4999.26171875

+/dev/vd6282/0/rls
  lux_scale=108.1642
