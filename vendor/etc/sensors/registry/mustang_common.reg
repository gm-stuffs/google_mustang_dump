  bus_name=i3c4
  bus_freq_hz=400000
  i3c_freq_hz=12300000
  i3c_push_pull_duty_cycle_pct=45
  bus_addr=0x68
  i3c_addr=0xa
  intr_id=33
  intr_gpio_id=55
  trigger_type=3
  spi_slew_rate_regval=5
  md_threshold=60
  md_duration_samples=1
  sd_threshold=60
  sd_timeout_ms=5000
  sd_batching_latency_ms=1000
  lowG_peak_threshold=848
  lowG_detect_timeout_ms=20
  lowG_debounce_timeout_ms=1000
+/dev/icm45631/0/accel
  orientation_transform=-2 1 3
  name=ICM45631 Accelerometer
  fac_cal_transform=0.9972 -0.00266 -0.00491 0.0044 0.9977 0.01403 0.00389 -0.0136 0.99809
  temp=31.2386
  temp_sensitivity=0.00043 0.00006 0.00295
+/dev/icm45631/0/gyro
  orientation_transform=-2 1 3
