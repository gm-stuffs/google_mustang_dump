#
# Mustang sensor device configuration registry script for all stages.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x50000:0xFFFF0000

#
# Buses
#

# I2C
+/dev/i2c/2
  bus_name=i2c2
  bus_index=2

# I3C
+/dev/i3c/0
  bus_name=i3c0
  bus_index=0
+/dev/i3c/4
  bus_name=i3c4
  bus_index=4

# SPI
+/dev/spi/3
  bus_name=spi3
  bus_index=3

# PDM
+/dev/pdm
  base_clk_hz=38400000

#
# Sensors
#

# ALSP (TMD3743)
+/dev/tmd3743/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=3
  intr_gpio_id=86
  anti_aliasing=1
  interlacing=1
  is_te2_node_enabled=1
  is_changable_pwm_supported=1
  # Leakage model type to use to calculate display leakage.
  #  0 : Compensate Lux using weighted Luma.
  #  1 : Compensate Lux using legacy plus modified C-channel histogram.
  #  2 : Compensate calculated XYZ values.
  #  3 : Compensate CRGBW channels.
  leakage_model_type=3

+/dev/tmd3743/0/prox
  auto_baseline=1
  gain1=64
  gain2=1
  temp_coeff=16
  pdata_scale=3.376
  pdata_baseline=4889
  far_threshold=900
  near_threshold=1500
  min_fps=30

+/dev/tmd3743/0/als
  # Display PWM table and dependent parameters.
  pwm_hz=240 480
  vsync_delay_us=756 745

  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=3000 16384
  itime_table_0=1600000 300000
  max_gain_table_0=7 7
  prox_delay_1hz_0=96000 96000
  prox_delay_10hz_0=91500 91500
  prox_delay_30hz_0=29000 29000
  prox_delay_60hz_0=13000 13000
  prox_delay_120hz_0=6500 6500
  itime_table_brightness_1=1500 3000 16384
  itime_table_1=1600000 1200000 300000
  max_gain_table_1=7 7 7
  prox_delay_1hz_1=96000 96000 96000
  prox_delay_10hz_1=91500 91500 91500
  prox_delay_30hz_1=29000 29000 29000
  prox_delay_60hz_1=13000 13000 13000
  prox_delay_120hz_1=6500 6500 6500

  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Alternate Lux equation parameters.
  # Format:
  #   per_chan_lux_coefs = <C_coef> <R_coef> <G_coef> <B_coef> <W_coef>
  #   c_g_ratio_modified_lux = r1 r2 r3 r4
  #      defined as:
  #      (C/G < r1) || (r4 < C/G)            =>  W-based  eq.
  #      (r1 < C/G < r2) || (r3 < C/G < r4)  =>  Weighted average between W-based and default eq.
  #      r2 < C/G < r3                       =>  Default eq.
  per_chan_lux_coefs=30 90 90 90 30
  c_g_ratio_modified_lux=2.4 2.8 4.8 5.2

  # Histogram Configuration.
  histo_enable=1
  # Display coordinates go from top left to bottom right.
  histo_roi_left=425
  histo_roi_top=200
  histo_roi_right=525
  histo_roi_bottom=300
  # The maximum brightness (DBV) value up to which histogram is active.
  # This value should match one of the itime_table_brightness values.
  histo_max_brightness=16384
  # Minimum change needed for a leakage value to be reported, i.e.,
  # min_change = MAX(min_change_value, current_leakage_val * min_change_rate)
  histo_min_change_value=0.5
  histo_min_change_rate=0.01
  # Histogram polling interval in ms.
  histo_polling_interval=50
  # Fallback luma value to use when histogram returns error (e.g., due to DRM).
  histo_fallback_luma=128.0

  ## Leakage calculator configuration.

  # Histo Luma matrix coefficients.
  # Format: histo_luma_matrix_<pwm_hz>_<n> = <start_DBV> <end_DBV> <<co-effs of luma-term matrix>>
  #         where: pwm_hz = PWM frequency; n = Luma matrix count.
  # The luma-term matrix applies for the given pwm_hz, when "start_DBV <= current_DBV <= end_DBV".
  histo_luma_matrix_240_0=0 3200 0.37067301 0.4641693 0.16515769 0.5132966 0.39482306 0.09188034 0.23618503 0.58377371 0.18004125 0.43785784 0.38739486 0.1747473 0.46822364 0.54425398 -0.01247762
  histo_luma_matrix_240_1=3201 16384 0.42643868 0.45723978 0.11632154 0.60055981 0.31748425 0.08195594 0.13092343 0.74747513 0.12160144 0.20287121 0.44209329 0.3550355 0.48186972 0.37322746 0.14490282
  histo_luma_matrix_480_0=0 3200 0.36993387 0.51647532 0.11359081 0.66728247 0.28904885 0.04366869 0.06880059 0.87362827 0.05757114 0.12394175 0.50684953 0.36920872 0.4113152 0.48549692 0.10318788
  histo_luma_matrix_480_1=3200 16384 0.43101672 0.4550889 0.11389439 0.6310165 0.31967346 0.04931004 0.16027812 0.74676355 0.09295833 0.25734024 0.41817056 0.3244892 0.51802015 0.39528127 0.08669858

  # Histo Luma exponent table.
  # Format: histo_luma_exp = <DBV1 exponent1> <DBV2 exponent2> ... <DBV_n exponent_n>
  #         where: DBV1 < DBV2 < ... < DBV_n.
  # For current_DBV, "exponent_x" value from first pair satisfying "current_DBV <= DBV_x" is chosen.
  histo_luma_exp=16384 1.5

  # Histo DBV equations.
  # Format: histo_dbv_eq_<pwm_hz>_<channel_index>_<n> = <start_DBV> <end_DBV> <eq_type>
  #                                                     <<equation co-efficients>>
  #         where: pwm_hz = PWM freq; channel_index = Leakage channel index enumerated as CRGBW;
  #                n = DBV equation count.
  # The DBV-term equation applies for the given pwm_hz, for the given leakage channel,
  # when "start_DBV <= current_DBV <= end_DBV".
  histo_dbv_eq_240_0_0=0 701 0 0
  histo_dbv_eq_240_0_1=702 3000 0 0.3640854019542298 -8.40806891006732e-05 1.0189466827343278e-07
  histo_dbv_eq_240_0_2=3001 16384 0 0.3116154293409187 -8.417668675237798e-05 9.391564247298638e-09
  histo_dbv_eq_240_1_0=0 701 0 0
  histo_dbv_eq_240_1_1=702 3000 0 0.4114994733798114 -9.35004866897992e-05 8.940064190115052e-08
  histo_dbv_eq_240_1_2=3001 16384 0 0.2798965272390004 -7.171536061315921e-05 8.646888152086907e-09
  histo_dbv_eq_240_2_0=0 701 0 0
  histo_dbv_eq_240_2_1=702 3000 0 0.35671480105454 -0.00017898351517377933 1.2835480641635258e-07
  histo_dbv_eq_240_2_2=3001 16384 0 0.30494939037576546 -8.076734697818872e-05 9.257857087487836e-09
  histo_dbv_eq_240_3_0=0 701 0 0
  histo_dbv_eq_240_3_1=702 3000 0 0.3338215748782989 -8.667976268841697e-05 9.845116393836792e-08
  histo_dbv_eq_240_3_2=3001 16384 0 0.26840248432659375 -7.855670425341299e-05 9.064563533730199e-09
  histo_dbv_eq_240_4_0=0 701 0 0
  histo_dbv_eq_240_4_1=702 3000 0 0.3418787405220693 -1.7765972962079163e-05 7.881560146703142e-08
  histo_dbv_eq_240_4_2=3001 16384 0 0.2717175612505476 -7.340750401249988e-05 8.922072479865399e-09

  histo_dbv_eq_480_0_0=0 701 0 0
  histo_dbv_eq_480_0_1=702 3000 0 9.540195761975193 -0.04104314857214957 7.132901024245461e-05 -6.221014557054158e-08 2.8875640148510623e-11 -6.816228393491015e-15 6.443179886760433e-19
  histo_dbv_eq_480_0_2=3001 16384 0 0.10274236624928715 -1.8546055828859824e-05 5.80815793435424e-09
  histo_dbv_eq_480_1_0=0 701 0 0
  histo_dbv_eq_480_1_1=702 3000 0 8.674347904300227 -0.03737971034348319 6.531018987050048e-05 -5.727729790919585e-08 2.674178630553291e-11 -6.350291845759776e-15 6.038179970606335e-19
  histo_dbv_eq_480_1_2=3001 16384 0 0.12347997682912641 -2.1231813557489277e-05 6.002301872826985e-09
  histo_dbv_eq_480_2_0=0 701 0 0
  histo_dbv_eq_480_2_1=702 3000 0 10.985594921732462 -0.04747471361023435 8.216318133014616e-05 -7.13597390111557e-08 3.2990714207239006e-11 -7.758773501681892e-15 7.308688978569137e-19
  histo_dbv_eq_480_2_2=3001 16384 0 0.10351864153936008 -1.746100251416613e-05 5.542168752807024e-09
  histo_dbv_eq_480_3_0=0 701 0 0
  histo_dbv_eq_480_3_1=702 3000 0 10.087304139651863 -0.04343680801873587 7.533113957972407e-05 -6.555492405871126e-08 3.035921640636247e-11 -7.152287784681193e-15 6.751480658125306e-19
  histo_dbv_eq_480_3_2=3001 16384 0 0.020162380137294947 4.3459757555232904e-07 4.5893897843877864e-09
  histo_dbv_eq_480_4_0=0 701 0 0
  histo_dbv_eq_480_4_1=702 3000 0 10.69835402914669 -0.04553516342524967 7.817860572172642e-05 -6.761348753391435e-08 3.121823682855533e-11 -7.346008572340243e-15 6.930706813803316e-19
  histo_dbv_eq_480_4_2=3001 16384 0 0.108244723211224 -2.0266874487875663e-05 6.0035453432059464e-09

  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240.0000 22.51 14.62 4.10 0.207 22.03 3000.0000 240.0000 29.07 19.52 9.45 4.38 31.27 13418.0000 480.0000 86.04 49.57 31.76 10.59 87.03 3000.0000 480.0000 31.28 21.73 10.45 5.20 31.55 13418.0000

+/dev/tmd3743/0/spectral
  priority=1

+/dev/tmd3743/0/color
  filter_size=100
  on_change_delta=150
  freeze_cct_on_inaccurate_leakage=1

# Display Info
+/dev/display_info/0
  # Link to ALS attached to this display.
  attached_alsp=/dev/tmd3743/0

