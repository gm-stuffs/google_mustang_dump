on property:ro.debuggable=1
    chown system system /sys/kernel/tracing/instances/goog_cpm_mailbox
    chown system system /sys/kernel/tracing/instances/goog_cpm_mailbox/trace
    # `cat buffer_total_size_kb` return 511
    write /sys/kernel/tracing/instances/goog_cpm_mailbox/buffer_size_kb 31
    write /sys/kernel/tracing/instances/goog_cpm_mailbox/per_cpu/cpu0/buffer_size_kb 293

    chown system system /sys/kernel/tracing/instances/goog_nq_mailbox
    chown system system /sys/kernel/tracing/instances/goog_nq_mailbox/trace
    # `cat buffer_total_size_kb` return 256
    write /sys/kernel/tracing/instances/goog_nq_mailbox/buffer_size_kb 7
    write /sys/kernel/tracing/instances/goog_nq_mailbox/per_cpu/cpu0/buffer_size_kb 207

on property:ro.debuggable=0
    rmdir /sys/kernel/tracing/instances/goog_nq_mailbox
    rmdir /sys/kernel/tracing/instances/goog_cpm_mailbox
