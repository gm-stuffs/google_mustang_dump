on property:sys.boot_completed=1
	chown system system /sys/class/power_supply/max77779fg/fg_learning_events
	chown system system /sys/class/power_supply/max77779fg/fg_abnormal_events
	chown system system /sys/class/power_supply/maxfg_base/fg_learning_events
	chown system system /sys/devices/platform/maxim,max77779fwu/update_stats
	chown system system /dev/logbuffer_max77779_fwupdate
	chown system system /dev/logbuffer_wlc_fw_update
	start vendor.pixelstats_vendor
on post-fs-data
    chown system system /sys/kernel/metrics/irq/stats_reset
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_AOC
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_AUR
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_BIG
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_BIG_MID
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_GPU
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_LITTLE
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_MID
    chown system system /sys/devices/platform/tmu_thermal/trip_counter_TPU
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/AOC/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/AUR/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/BIG/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/BIG_MID/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/GPU/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/LITTLE/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/MID/reset_trip_cnt
    chown system system /sys/firmware/mbfs_root/cpm/thermal/tj/TPU/reset_trip_cnt

service vendor.pixelstats_vendor /vendor/bin/pixelstats-vendor
    class hal
    user system
    group system context_hub readproc
    disabled