	fragment@buttons {
		target-path = "/";

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <0x01 0x02 0x03>;
				phandle = <0x251>;

				button-voldn {
					label = "gpio-keys: KEY_VOLUMEDOWN";
					linux,code = <0x72>;
					gpios = <0xffffffff 0x33 0x01>;
					wakeup-source;
				};

				button-volup {
					label = "gpio-keys: KEY_VOLUMEUP";
					linux,code = <0x73>;
					gpios = <0xffffffff 0x34 0x01>;
					wakeup-source;
				};

				button-power {
					label = "gpio-keys: KEY_POWER";
					linux,code = <0x74>;
					gpios = <0xffffffff 0x30 0x01>;
					wakeup-source;
				};
			};
		};
	};

