			rng-seed = "deadbeef deadbeef deadbeef deadbeef deadbeef deadbeef /\n      deadbeef deadbeef deadbeef deadbeef deadbeef deadbeef /\n      deadbeef deadbeef deadbeef deadbeef deadbeef deadbeef";
		};
	};

