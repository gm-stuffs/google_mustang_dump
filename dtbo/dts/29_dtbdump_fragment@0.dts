				drive-strength = <0x04>;
				input-enable;
				output-enable;
				function = "lsios_cli6";
				phandle = <0x41>;
			};

			xlsios_cli6_pin0_sleep {
				pins = "XLSIOS_CLI6_PIN0";
				input-enable;
				output-low;
				function = "lsios_gpio";
				phandle = <0x44>;
			};

			xlsios_cli6_pin1 {
				pins = "XLSIOS_CLI6_PIN1";
				bias-disable;
				drive-strength = <0x04>;
				input-enable;
				output-enable;
				function = "lsios_cli6";
				phandle = <0x42>;
			};

			xlsios_cli6_pin1_sleep {
				pins = "XLSIOS_CLI6_PIN1";
				input-enable;
				output-low;
				function = "lsios_gpio";
				phandle = <0x45>;
			};

			xlsios_cli6_pin2 {
				pins = "XLSIOS_CLI6_PIN2";
				bias-pull-down;
				input-enable;
				output-disable;
				function = "lsios_cli6";
				phandle = <0x43>;
			};

			xlsios_cli6_pin2_sleep {
				pins = "XLSIOS_CLI6_PIN2";
				bias-pull-down;
				input-enable;
				output-disable;
				function = "lsios_gpio";
				phandle = <0x46>;
			};

			xlsios_cli6_pin3_l41 {
				pins = "XLSIOS_CLI6_PIN3";
				bias-disable;
				drive-strength = <0x04>;
				input-enable;
				output-enable;
				function = "lsios_gpio";
				phandle = <0x1e2>;
			};

			xlsios_cli6_pin3_l41_sleep {
				pins = "XLSIOS_CLI6_PIN3";
				input-enable;
				output-high;
				function = "lsios_gpio";
				phandle = <0x1e3>;
			};
		};
	};

