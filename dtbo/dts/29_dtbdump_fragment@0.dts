	fragment@260 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";

			max77779pmic@f {
				compatible = "maxim,max77779pmic-spmi";
				reg = <0x0f 0x00>;
				phandle = <0x89>;

				max77779pmicirq {
					compatible = "max77779-pmic-irq";
					pinctrl-names = "default";
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x86>;
					interrupt-parent = <0xffffffff>;
					max777x9,irq-gpio = <0xffffffff 0x26 0x01>;
					phandle = <0x88>;
				};

				max77779pinctrl {
					compatible = "max77779-pinctrl";
					phandle = <0x87>;

					wc_irq {
						pins = "gpio4";
						function = "gpio";
						bias-pull-up;
						phandle = <0x8f>;
					};

					mode_gpio {
						pins = "gpio3";
						function = "gpio";
						output-low;
						bias-disable;
						phandle = <0x90>;
					};
				};

				max77779_sgpio {
					gpio-controller;
					compatible = "max77779-pmic-sgpio";
					#gpio-cells = <0x02>;
					pinctrl-names = "default";
