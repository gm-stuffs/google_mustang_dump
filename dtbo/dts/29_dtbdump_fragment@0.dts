				gpio_names = "C1_T0__XLSIOS_CLI2_PIN0\0C1_T1__XLSIOS_CLI2_PIN1\0C1_T3__XLSIOS_CLI2_PIN2\0C2_T0__XLSIOS_CLI2_PIN3";
				default_signals = "gp_region_0\0gp_region_1\0gp_region_2\0gp_region_3";
				phandle = <0x1f1>;
