				pp1350-supply = <0x7e>;
				ldo7-supply = <0xbe>;
				ldo5-supply = <0xbf>;
				vio-supply = <0xffffffff>;
				ldo4-supply = <0xae>;
				gpio3-supply = <0xc0>;
				pinctrl-names = "mclk_on\0mclk_off\0vsync_on\0vsync_off";
				pinctrl-0 = <0xffffffff>;
				pinctrl-1 = <0xffffffff>;
				pinctrl-2 = <0xc1>;
				pinctrl-3 = <0xc2>;
				power-seq = <0xc3>;
				transaction-thread-priority = <0x63>;
				i2c-lock-group-id = <0x03>;
				phandle = <0x20f>;
			};

			flash@0 {
				compatible = "google,lwis-i2c-device";
				node-name = "flash-lm3644";
				i2c-bus = <0xffffffff>;
				i2c-addr = <0x63>;
				reg-addr-bitwidth = <0x08>;
				reg-value-bitwidth = <0x08>;
				enable-gpios = <0xffffffff 0x16 0x00>;
				power-up-seqs = "enable";
				power-up-seq-types = "gpio";
				power-up-seq-delays-us = <0x00>;
				power-down-seqs = "enable";
				power-down-seq-types = "gpio";
				power-down-seq-delays-us = <0x00>;
				phandle = <0x210>;
			};
		};
	};

	fragment@280 {
		target = <0xffffffff>;

		__overlay__ {

			u100@0 {
				u100-power-switch-gpios = <0xffffffff 0x14 0x00>;
			};
		};
	};

