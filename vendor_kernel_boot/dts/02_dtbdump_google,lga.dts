	pmu@10000000 {
		compatible = "arm,ci-700";
		reg = <0x00 0x10000000 0x00 0x2000000>;
		interrupts = <0x00 0x4d 0x04 0x00>;
	};

	booker {
		compatible = "google,booker-ci";
		reg_base = <0x10000000>;
		interrupts = <0x00 0x47 0x04 0x00 0x00 0x48 0x04 0x00 0x00 0x49 0x04 0x00 0x00 0x4a 0x04 0x00>;
		interrupt-names = "BCI: Non-secure error\0BCI: Secure error\0BCI: Non-secure fault\0BCI: Secure fault";
		interrupt-is-secure = <0x00 0x01 0x00 0x01>;
		interrupt-is-error = <0x01 0x01 0x00 0x00>;
		status = "okay";

		node0 {
			device_type = "booker-cfg";
			offset = <0x00>;
			id = <0x14>;
		};

		node1 {
			device_type = "booker-mtsx";
			offset = <0x280000>;
			id = <0x02>;
		};

		node2 {
			device_type = "booker-mtsx";
			offset = <0x680000>;
			id = <0x0a>;
		};

		node3 {
