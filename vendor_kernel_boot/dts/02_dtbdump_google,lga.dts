	irm_gmc_freq {
		compatible = "google,irm-devfreq";
		irm-client-idx = <0x00>;
		irm-min-clamp-reg = <0x1c>;
		irm-trigger-reg = <0x40>;
		gmc-memss-table = <0x1860d840 0xa9c1080 0x2001f840 0xa9c1080 0x280de800 0xde34c40 0x324e6b00 0xde34c40 0x3b7c4580 0x1bc69880 0x501bd000 0x1bc69880 0x5b8d8000 0x27b25a80 0x64ac1840 0x27b25a80 0x76f88b00 0x2a60ffc0 0x84bd52c0 0x2faf0800 0xa037a000 0x2faf0800 0xbba2ab00 0x2faf0800 0xdbb3e580 0x378d3100 0xfbc52000 0x378d3100>;
		phandle = <0x4bc>;

		gmc_dvfs {
			dvfs-helper-domain-name = "gmc";
		};

		memss_dvfs {
