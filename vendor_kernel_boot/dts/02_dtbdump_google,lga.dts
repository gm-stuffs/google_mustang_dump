		power-domain-names = "csr_access_pd\0pad_function_pd";
		interrupt-controller;
		#interrupt-cells = <0x02>;
		interrupts-extended = <0xc3 0x00 0xc3 0x01 0xc3 0x02 0xc3 0x03 0xc3 0x04 0xc3 0x05 0xc3 0x06 0xc3 0x07 0xc3 0x18 0xc3 0x19 0xc3 0x1a 0xc3 0x1b 0xc3 0x08 0xc3 0x09 0xc3 0x0a 0xc3 0x0b 0xc3 0x0c 0xc3 0x0d 0xc3 0x0e 0xc3 0x0f 0xc3 0x10 0xc3 0x11 0xc3 0x12 0xc3 0x13 0xc3 0x14 0xc3 0x15 0xc3 0x16 0xc3 0x17 0xc3 0x1c 0xc3 0x1d 0xc3 0x1e 0xc3 0x1f>;
