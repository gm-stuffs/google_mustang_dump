	pinctrl@6480000 {
		compatible = "google,lga-gdmc-pinctrl";
		reg = <0x00 0x6480000 0x00 0x15000>;
		gpio-controller;
		gpio-ranges = <0x440 0x00 0x00 0x15>;
		#gpio-cells = <0x02>;
		gpio-reserved-ranges = <0x06 0x07>;
		sswrp-wakeup-capable;
		interrupt-controller;
		#interrupt-cells = <0x02>;
		interrupts = <0x00 0x296 0x04 0x00 0x00 0x295 0x04 0x00 0x00 0x294 0x04 0x00 0x00 0x293 0x04 0x00 0x00 0x292 0x04 0x00 0x00 0x291 0x04 0x00 0x00 0x290 0x04 0x00 0x00 0x28f 0x04 0x00>;
