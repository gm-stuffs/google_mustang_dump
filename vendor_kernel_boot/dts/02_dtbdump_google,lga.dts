	pinctrl@3A200000 {
		compatible = "google,lga-lsioe-pinctrl";
		reg = <0x00 0x3a200000 0x00 0x20000>;
		gpio-controller;
		gpio-ranges = <0x3a3 0x00 0x00 0x20>;
		#gpio-cells = <0x02>;
		clocks = <0x439>;
