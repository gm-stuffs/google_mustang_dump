	sswrp_codec3p@3f000000 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x3f000000 0x200000>;
		phandle = <0x7c0>;

		vpu@140000 {
			compatible = "google,vpu";
			status = "ok";
			reg = <0x140000 0x8000 0x171000 0x50>;
			reg-names = "vpu\0qchctl_vpu";
			devfreq = <0x44b>;
			ras = <0x44c 0x44d>;
			ra-names = "ra0\0ra1";
			interrupts = <0x00 0x232 0x04 0x00>;
			power-domains = <0x438 0x438>;
			interconnects = <0x3f 0x0c 0x3f 0x00>;
			interconnect-names = "sswrp-codec-3p";
			iommus = <0x5b 0x8940 0x5b 0x8948 0x5b 0x8902 0x5b 0x890a 0x5b 0x8901 0x5b 0x8909 0x5b 0x8903 0x5b 0x890b 0x5b 0x890d 0x5b 0x8906 0x5b 0x890e 0x5b 0x890c 0x5b 0x8907 0x5b 0x890f>;
			iommu-names = "c3p_seqid_0_ns_0\0c3p_seqid_0_ns_1\0c3p_seqid_2_ns_0\0c3p_seqid_2_ns_1\0c3p_seqid_1_ns_0\0c3p_seqid_1_ns_1\0c3p_seqid_3_ns_0\0c3p_seqid_3_ns_1\0c3p_seqid_5_ns\0c3p_seqid_6_ns_0\0c3p_seqid_6_ns_1\0c3p_seqid_4_ns\0c3p_seqid_7_ns_0\0c3p_seqid_7_ns_1";
			pt_id = "vpu_p0";
			phandle = <0x7c1>;
		};

		ra@80000 {
			compatible = "google,ra";
			reg = <0x80000 0x1000>;
			power-domains = <0x438>;
			phandle = <0x44c>;
