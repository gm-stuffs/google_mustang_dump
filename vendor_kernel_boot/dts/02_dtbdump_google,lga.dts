		compatible = "google,tmu-stats";
		group-name = "tmu";
		phandle = <0x7c4>;
	};

	thermal_pressure {
		compatible = "google,thermal-pressure-tj";
		group-name = "tmu";
		active-polling-delay-ms = <0x64>;
		passive-polling-delay-ms = <0x9c4>;
		phandle = <0x7c5>;

		cluster_config {

			thermal-pressure-big {
				first-cpu = <0x44f>;
				cdev-id = <0x00>;
			};

			thermal-pressure-big-mid {
				first-cpu = <0x450>;
				cdev-id = <0x01>;
			};

			thermal-pressure-mid {
				first-cpu = <0x451>;
				cdev-id = <0x02>;
			};

			thermal-pressure-little {
				first-cpu = <0x452>;
				cdev-id = <0x03>;
			};
		};
	};

	thermal-zones {
		phandle = <0x7c6>;

		BIG {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x453 0x00>;
